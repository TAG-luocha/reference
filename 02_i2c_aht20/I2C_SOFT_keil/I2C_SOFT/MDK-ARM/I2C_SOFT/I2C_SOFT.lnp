--cpu Cortex-M3
"i2c_soft\startup_stm32f103xb.o"
"i2c_soft\main.o"
"i2c_soft\gpio.o"
"i2c_soft\usart.o"
"i2c_soft\stm32f1xx_it.o"
"i2c_soft\stm32f1xx_hal_msp.o"
"i2c_soft\stm32f1xx_hal_gpio_ex.o"
"i2c_soft\stm32f1xx_hal_uart.o"
"i2c_soft\stm32f1xx_hal.o"
"i2c_soft\stm32f1xx_hal_rcc.o"
"i2c_soft\stm32f1xx_hal_rcc_ex.o"
"i2c_soft\stm32f1xx_hal_gpio.o"
"i2c_soft\stm32f1xx_hal_dma.o"
"i2c_soft\stm32f1xx_hal_cortex.o"
"i2c_soft\stm32f1xx_hal_pwr.o"
"i2c_soft\stm32f1xx_hal_flash.o"
"i2c_soft\stm32f1xx_hal_flash_ex.o"
